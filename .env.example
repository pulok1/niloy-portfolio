# Public URL of the deployed site, no trailing slash. Used for canonical
# links, Open Graph tags, sitemap and JSON-LD.
#   Vercel:        https://niloy-bhattacharjee.vercel.app
#   GitHub Pages:  https://<user>.github.io/<repo>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only for GitHub Pages project sites: "/<repo>". Leave empty otherwise.
NEXT_PUBLIC_BASE_PATH=

# Set to "true" to hide unfilled TODO placeholders instead of showing them.
NEXT_PUBLIC_HIDE_PLACEHOLDERS=false
